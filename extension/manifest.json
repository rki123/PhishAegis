{
    "manifest_version": 3,
    "name": "PhishAegis",
    "version": "1.0",
    "description": "PhishAegis { Malicious Urls Detector System }",
    "action": {
        "default_popup": "popup.html"
    },
    "permissions": [
        "activeTab"
    ],
    "host_permissions": [
        "http://127.0.0.1:5000/*"
    ]
}
